# No credentials required for local simulation. Never expose DEMO_MODE to a network.
DEMO_MODE=true
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:5173
DATABASE_URL=.data/tab.sqlite
SESSION_SECRET=
PHOTON_ENABLED=false
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
GEMINI_API_KEY=
# Recommended locally: absolute path to a protected key file outside the repository.
# Use this OR GEMINI_API_KEY, never both. Loaded only by the server.
GEMINI_API_KEY_FILE=
# Set to a Flash model currently available in your Gemini account.
GEMINI_MODEL=
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
DEMO_CUSTODIAL_WALLETS=false
TAB_TEST_TOKEN_MINT=
TREASURY_KEY_PATH=.data/treasury.json
# Alternative to protected key file: JSON array of secret key bytes; never log it.
TREASURY_SECRET_KEY=
# Generate: openssl rand -hex 32
WALLET_ENC_KEY=
