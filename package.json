{
  "name": "tab-hacknc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "bun server/src/index.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "seed:demo": "bun scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "vite build",
    "demo:smoke": "bun scripts/smoke-demo.ts",
    "setup:devnet": "bun scripts/setup-devnet.ts",
    "demo:devnet": "bun scripts/live-devnet.ts",
    "check:photon": "bun scripts/check-photon.ts",
    "db:generate": "drizzle-kit generate",
    "test:browser": "bun scripts/browser-smoke.ts",
    "format": "prettier --write server/src scripts web/src vite.config.ts drizzle.config.ts",
    "format:check": "prettier --check server/src scripts web/src vite.config.ts drizzle.config.ts",
    "test:browser:dm": "bun scripts/browser-direct-tabs.ts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "spectrum-ts": "12.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "6.3.5"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
