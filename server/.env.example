# Any key left blank turns that feature off and falls back to a local stub,
# so the simulator (npm run sim) works with an empty .env.

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000   # must be a stable HTTPS domain for Apple Pay
DATABASE_PATH=./data/tab.db
DEMO_MODE=true                          # short job intervals for demos

# Photon Spectrum (1:1 iMessage DMs)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
BOT_HANDLE=+15555550100                 # bot's iMessage phone/email, used in sms: join links

# Gemini (blank = regex fallback extractor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Solana devnet (blank = simulated payments). Run `npm run setup:devnet` to fill these in.
SOLANA_RPC_URL=https://api.devnet.solana.com
TREASURY_SECRET_KEY=
USDC_MINT=
WALLET_ENC_KEY=                         # 64 hex chars; blank = dev key (not safe beyond local)

# Stripe test mode (blank = Apple Pay disabled)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs pay links + API tokens (blank = dev secret)
APP_SECRET=
